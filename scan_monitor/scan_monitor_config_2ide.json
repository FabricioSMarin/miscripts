{
    "_README": "Flag conditions are NOT expressed in JSON. Each flag's calculation lives in scan_monitor_flags.py. The 'inputs' PVs listed under each flag are read every poll and passed as the context dict (keyed by label) to the matching flag function, which returns True when the fault condition is met. 'flag_events' is the diagnostic snapshot logged whenever any flag fires.",
  
    "scan_number_pv": "2xfm:saveData_scanNumber",
    "output_dir_pv": "2xfm:saveData_fileSystem",
    "linux_data_mount": "/mnt/micdata1/2ide/",
    "environment_variables": {
      "EPICS_CA_ADDR_LIST": "164.54.113.168 10.54.113.53 10.54.113.147 10.54.113.91 10.54.113.58"
    },
  
    "flag_confirm_s": 5.0,
  
    "scan_started": [
      {
        "pv": "2xfm:Fscan1.BUSY",
        "when": "eq",
        "value": 1,
        "comment": "Fly-scan outer loop (Fscan1) goes busy 0->1 at the start of a 2D fly scan"
      },
      {
        "pv": "2xfm:scan2.BUSY",
        "when": "eq",
        "value": 1,
        "comment": "Step-scan outer loop (scan2) goes busy 0->1 at the start of a 2D step scan"
      },
      {
        "pv": "2xfm:scan1.BUSY",
        "when": "eq",
        "value": 1,
        "comment": "Step-scan inner/1D loop (scan1). Nested 2D inner-line edges are ignored when scan2 is already busy"
      }
    ],
  
    "scan_parameters": [
      {"label": "saveData_message", "pv": "2xfm:saveData_message", "as": "string"},
      {"label": "next_scan_number", "pv": "2xfm:saveData_scanNumber"},
      {"label": "dwell_time", "pv": "2xfm:Flyscans:Setup:DwellTime.VAL"},
      {"label": "Xnpts", "pv": "2xfm:FscanH.NPTS"},
      {"label": "Ynpts", "pv": "2xfm:Fscan1.NPTS"},
      {"label": "Xstart", "pv": "2xfm:FscanH.P1SP"},
      {"label": "Xend", "pv": "2xfm:FscanH.P1EP"},
      {"label": "Xstep", "pv": "2xfm:FscanH.P1SI"},
      {"label": "Xwidth", "pv": "2xfm:FscanH.P1WD"},
      {"label": "Xcenter", "pv": "2xfm:FscanH.P1CP"},
      {"label": "Ystart", "pv": "2xfm:Fscan1.P1SP"},
      {"label": "Yend", "pv": "2xfm:Fscan1.P1EP"},
      {"label": "Ystep", "pv": "2xfm:Fscan1.P1SI"},
      {"label": "Ywidth", "pv": "2xfm:Fscan1.P1WD"},
      {"label": "Ycenter", "pv": "2xfm:Fscan1.P1CP"},
      {"label": "step_Xnpts", "pv": "2xfm:scan1.NPTS", "optional": true, "comment": "Step-scan inner (X) = scan1; outer (Y) = scan2"},
      {"label": "step_Ynpts", "pv": "2xfm:scan2.NPTS", "optional": true},
      {"label": "step_Xstart", "pv": "2xfm:scan1.P1SP", "optional": true},
      {"label": "step_Xend", "pv": "2xfm:scan1.P1EP", "optional": true},
      {"label": "step_Xstep", "pv": "2xfm:scan1.P1SI", "optional": true},
      {"label": "step_Xwidth", "pv": "2xfm:scan1.P1WD", "optional": true},
      {"label": "step_Xcenter", "pv": "2xfm:scan1.P1CP", "optional": true},
      {"label": "step_Ystart", "pv": "2xfm:scan2.P1SP", "optional": true},
      {"label": "step_Yend", "pv": "2xfm:scan2.P1EP", "optional": true},
      {"label": "step_Ystep", "pv": "2xfm:scan2.P1SI", "optional": true},
      {"label": "step_Ywidth", "pv": "2xfm:scan2.P1WD", "optional": true},
      {"label": "step_Ycenter", "pv": "2xfm:scan2.P1CP", "optional": true}
    ],
  
    "flags": {
      "beam_dump": {
        "comment": "Storage ring beam lost: S:ActualMode leaves user/top-up mode (4) and/or ring current collapses.",
        "inputs": [
          {"label": "actual_mode", "pv": "S:ActualMode"},
          {"label": "desired_mode", "pv": "S:DesiredMode"}
        ]
      },
  
    "scan_paused": {
      "comment": "Fly or step scan pause/wait went active. Labels containing _step are optional extras ORed with the fly PVs.",
      "inputs": [
        {"label": "is_paused", "pv": "2xfm:FscanPause.VAL"},
        {"label": "is_paused_step", "pv": "2xfm:scanPause.VAL", "optional": true},
        {"label": "is_wait_inner", "pv": "2xfm:FscanH.WCNT"},
        {"label": "is_wait_outer", "pv": "2xfm:Fscan1.WCNT"},
        {"label": "is_wait_inner_step", "pv": "2xfm:scan1.WCNT", "optional": true},
        {"label": "is_wait_outer_step", "pv": "2xfm:scan2.WCNT", "optional": true},
        {"label": "scan_busy", "pv": "2xfm:Fscan1.BUSY"},
        {"label": "scan_busy_step_inner", "pv": "2xfm:scan1.BUSY", "optional": true},
        {"label": "scan_busy_step_outer", "pv": "2xfm:scan2.BUSY", "optional": true}
      ]
    },
  
    "scan_unpaused": {
      "comment": "Fly or step scan pause/wait went inactive while a scan is still busy.",
      "inputs": [
        {"label": "is_paused", "pv": "2xfm:FscanPause.VAL"},
        {"label": "is_paused_step", "pv": "2xfm:scanPause.VAL", "optional": true},
        {"label": "is_wait_inner", "pv": "2xfm:FscanH.WCNT"},
        {"label": "is_wait_outer", "pv": "2xfm:Fscan1.WCNT"},
        {"label": "is_wait_inner_step", "pv": "2xfm:scan1.WCNT", "optional": true},
        {"label": "is_wait_outer_step", "pv": "2xfm:scan2.WCNT", "optional": true},
        {"label": "scan_busy", "pv": "2xfm:Fscan1.BUSY"},
        {"label": "scan_busy_step_inner", "pv": "2xfm:scan1.BUSY", "optional": true},
        {"label": "scan_busy_step_outer", "pv": "2xfm:scan2.BUSY", "optional": true}
      ]
    },
  
    "scan_aborted": {
      "comment": "Fly or step scan status message reports Abort.",
      "inputs": [
        {"label": "message_outer", "pv": "2xfm:Fscan1.SMSG", "as": "string"},
        {"label": "message_inner", "pv": "2xfm:FscanH.SMSG", "as": "string"},
        {"label": "message_outer_step", "pv": "2xfm:scan2.SMSG", "as": "string", "optional": true},
        {"label": "message_inner_step", "pv": "2xfm:scan1.SMSG", "as": "string", "optional": true}
      ]
    },
  
  
      "struck_stuck_acquiring": {
        "comment": "MCS 3820 remains acquiring even after receiving all triggers (current_channel reached nuse_all but Acquiring stays 1 and scan is no longer busy).",
        "inputs": [
          {"label": "acquiring", "pv": "2xfm:mcs:Acquiring"},
          {"label": "nuse_all", "pv": "2xfm:mcs:NuseAll"},
          {"label": "current_channel", "pv": "2xfm:mcs:CurrentChannel"},
          {"label": "scan_busy", "pv": "2xfm:Fscan1.BUSY"},
          {"label": "is_paused", "pv": "2xfm:FscanPause.VAL"},
          {"label": "is_wait_inner", "pv": "2xfm:FscanH.WCNT"},
          {"label": "is_wait_outer", "pv": "2xfm:Fscan1.WCNT"}
          
        ]
      },
  
      "struck_miss_trigger": {
        "comment": "MCS 3820 still acquiring and missing triggers (current_channel < nuse_all) but the stage already completed its motion (requested ~ actual position).",
        "inputs": [
          {"label": "scan_busy", "pv": "2xfm:Fscan1.BUSY"},
          {"label": "acquiring", "pv": "2xfm:mcs:Acquiring"},
          {"label": "nuse_all", "pv": "2xfm:mcs:NuseAll"},
          {"label": "dwell_time", "pv": "2xfm:Flyscans:Setup:DwellTime.VAL"},
          {"label": "elapsed_time", "pv": "2xfm:mcs:ElapsedReal"},
          {"label": "current_channel", "pv": "2xfm:mcs:CurrentChannel"},
          {"label": "requested_position", "pv": "2xfm:m57.VAL"},
          {"label": "actual_position", "pv": "2xfm:m57.RBV"}
        ]
      },

      "xmap_miss_trigger": {
        "comment": "XMAP missed triggers: acq_counter lags acq_target while struck is done.",
        "inputs": [
          {"label": "scan_busy", "pv": "2xfm:Fscan1.BUSY"},
          {"label": "acq_target", "pv": "dxpXMAP2xfm3:PixelsPerRun"},
          {"label": "acq_counter", "pv": "dxpXMAP2xfm3:dxp1:CurrentPixel"},
          {"label": "struck_current", "pv": "2xfm:mcs:CurrentChannel"},
          {"label": "struck_all", "pv": "2xfm:mcs:NuseAll"},
          {"label": "struck_acquiring", "pv": "2xfm:mcs:Acquiring"}
        ]
      },
  
      "xmap_lost_frames": {
        "comment": "xmap lost frames: number of saved frames differs from received triggers and the HDF writer remains capturing.",
        "inputs": [
          {"label": "scan_busy", "pv": "2xfm:Fscan1.BUSY"},
          {"label": "num_frames", "pv": "dxpXMAP2xfm3:netCDF1:NumCapture_RBV"},
          {"label": "saved_frames", "pv": "dxpXMAP2xfm3:netCDF1:NumCaptured_RBV"},
          {"label": "struck_current", "pv": "2xfm:mcs:CurrentChannel"},
          {"label": "struck_all", "pv": "2xfm:mcs:NuseAll"},
          {"label": "struck_acquiring", "pv": "2xfm:mcs:Acquiring"}
        ]
      },
  
      "write_error": {
        "comment": "xmap write error: the detector is in an error state and the HDF writer is not capturing.",
        "inputs": [
          {"label": "scan_busy", "pv": "2xfm:Fscan1.BUSY"},
          {"label": "write_status", "pv": "dxpXMAP2xfm3:netCDF1:WriteStatus"}
        ]
      },
  
      "filename_not_insync": {
        "comment": "XMAP filename PVs are out of sync with the scan.",
        "inputs": [
          {"label": "scan_busy", "pv": "2xfm:Fscan1.BUSY"},
          {"label": "capture", "pv": "dxpXMAP2xfm3:netCDF1:Capture_RBV"},
          {"label": "detector_file_number", "pv": "dxpXMAP2xfm3:netCDF1:FileNumber"},
          {"label": "detector_file_name", "pv": "dxpXMAP2xfm3:netCDF1:FileName", "as": "string"},
          {"label": "scan_line", "pv": "2xfm:Fscan1.CPT"},
          {"label": "next_scan_number", "pv": "2xfm:saveData_scanNumber"}
        ]
      },
  
      "stage_stuck": {
        "comment": "Sample stage does not advance to its next scan position: requested != actual position persists while the scan is busy and velocity is ~0.",
        "inputs": [
          {"label": "struck_acquiring", "pv": "2xfm:mcs:Acquiring"},
          {"label": "inner_busy", "pv": "2xfm:FscanH.BUSY"},
          {"label": "is_moving", "pv": "2xfm:m57.DMOV"},
          {"label": "struck_current", "pv": "2xfm:mcs:CurrentChannel"},
          {"label": "elapsed_time", "pv": "2xfm:mcs:ElapsedReal"}
        ]
      },

      "memory_high": {
        "comment": "Host OS memory usage crossed above 50% (orange). Fires once; resets when usage drops to <=50%.",
        "inputs": []
      },

      "memory_critical": {
        "comment": "Host OS memory usage crossed above 75% (red). Fires once; resets when usage drops to <=75%.",
        "inputs": []
      }
    },
  
    "flag_events": [
      {"label": "scan_execute", "pv": "2xfm:Fscan1.EXSC"},
      {"label": "acquiring", "pv": "2xfm:mcs:Acquiring"},
      {"label": "dwell_time", "pv": "2xfm:Flyscans:Setup:DwellTime.VAL"},
      {"label": "elapsed_real", "pv": "2xfm:mcs:ElapsedReal"},
      {"label": "nuse_all", "pv": "2xfm:mcs:NuseAll"},
      {"label": "current_channel", "pv": "2xfm:mcs:CurrentChannel"},
      {"label": "acq_target", "pv": "dxpXMAP2xfm3:PixelsPerRun"},
      {"label": "acq_counter", "pv": "dxpXMAP2xfm3:dxp1:CurrentPixel"},
      {"label": "is_acquiring", "pv": "dxpXMAP2xfm3:Acquiring"},
      {"label": "collect_mode", "pv": "dxpXMAP2xfm3:CollectMode"},
      {"label": "capture", "pv": "dxpXMAP2xfm3:netCDF1:Capture_RBV"},
      {"label": "full_file_name", "pv": "dxpXMAP2xfm3:netCDF1:FullFileName_RBV", "as": "string"},
      {"label": "file_path_exists", "pv": "dxpXMAP2xfm3:netCDF1:FilePathExists_RBV"},
      {"label": "requested_position", "pv": "2xfm:m57.VAL"},
      {"label": "actual_position", "pv": "2xfm:m57.RBV"},
      {"label": "velocity", "pv": "2xfm:m57.VELO"},
      {"label": "vmax", "pv": "2xfm:m57.VMAX"},
      {"label": "beam_current", "pv": "S:SRcurrentAI"},
      {"label": "actual_mode", "pv": "S:ActualMode"}
    ]
  }
  