{
  "_README": "Flag conditions are NOT expressed in JSON. Each flag's calculation lives in scan_monitor_flags.py. The 'inputs' PVs listed under each flag are read every poll and passed as the context dict (keyed by label) to the matching flag function, which returns True when the fault condition is met. 'flag_events' is the diagnostic snapshot logged whenever any flag fires.",

  "scan_number_pv": "8bmbsft:saveData_scanNumber",
  "output_dir_pv": "8bmbsft:saveData_fileSystem",

  "environment_variables": {
    "EPICS_CA_ADDR_LIST": "10.54.108.4"
  },

  "flag_confirm_s": 5.0,

  "scan_started": [
    {
      "pv": "8bmbsft:Fscan1.BUSY",
      "when": "eq",
      "value": 1,
      "comment": "Execute-scan goes active at the start of a 2D scan when value changes from 0 to 1"
    }
  ],

  "scan_parameters": [
    {"label": "scan_number", "pv": "8bmbsft:saveData_scanNumber"},
    {"label": "dwell_time", "pv": "8bmb:Flyscans:Setup:DwellTime.VAL"},
    {"label": "Xnpts", "pv": "8bmbsft:FscanH.NPTS"},
    {"label": "Ynpts", "pv": "8bmbsft:Fscan1.NPTS"},
    {"label": "Xstart", "pv": "8bmbsft:FscanH.P1SP"},
    {"label": "Xend", "pv": "8bmbsft:FscanH.P1EP"},
    {"label": "Xstep", "pv": "8bmbsft:FscanH.P1SI"},
    {"label": "Xwidth", "pv": "8bmbsft:FscanH.P1WD"},
    {"label": "Xcenter", "pv": "8bmbsft:FscanH.P1CP"},
    {"label": "Ystart", "pv": "8bmbsft:Fscan1.P1SP"},
    {"label": "Yend", "pv": "8bmbsft:Fscan1.P1EP"},
    {"label": "Ystep", "pv": "8bmbsft:Fscan1.P1SI"},
    {"label": "Ywidth", "pv": "8bmbsft:Fscan1.P1WD"},
    {"label": "Ycenter", "pv": "8bmbsft:Fscan1.P1CP"},
    {"label": "saveData_message", "pv": "8bmbsft:saveData_message"}
  ],

  "flags": {
    "beam_dump": {
      "comment": "Storage ring beam lost: S:ActualMode leaves user/top-up mode (4) and/or ring current collapses.",
      "inputs": [
        {"label": "actual_mode", "pv": "S:ActualMode"},
        {"label": "desired_mode", "pv": "S:DesiredMode"}
      ]
    },

  "scan_paused": {
    "comment": "Scan pause record went active.",
    "inputs": [
      {"label": "is_paused", "pv": "8bmbsft:FscanPause.VAL"},
      {"label": "is_wait_inner", "pv": "8bmbsft:FscanH.WCNT"},
      {"label": "is_wait_outer", "pv": "8bmbsft:Fscan1.WCNT"},
      {"label": "scan_busy", "pv": "8bmbsft:Fscan1.BUSY"}
    ]
  },

  "scan_unpaused": {
    "comment": "Scan pause record went inactive.",
    "inputs": [
      {"label": "is_paused", "pv": "8bmbsft:FscanPause.VAL"},
      {"label": "is_wait_inner", "pv": "8bmbsft:FscanH.WCNT"},
      {"label": "is_wait_outer", "pv": "8bmbsft:Fscan1.WCNT"},
      {"label": "scan_busy", "pv": "8bmbsft:Fscan1.BUSY"}
    ]
  },

  "scan_aborted": {
    "comment": "Scan was aborted.",
    "inputs": [
      {"label": "message_outer", "pv": "8bmbsft:Fscan1.SMSG", "as": "string"},
      {"label": "message_inner", "pv": "8bmbsft:FscanH.SMSG", "as": "string"}
    ]
  },


    "struck_stuck_acquiring": {
      "comment": "MCS 3820 remains acquiring even after receiving all triggers (current_channel reached nuse_all but Acquiring stays 1 and scan is no longer busy).",
      "inputs": [
        {"label": "acquiring", "pv": "8bmb:3820:Acquiring"},
        {"label": "nuse_all", "pv": "8bmb:3820:NuseAll"},
        {"label": "current_channel", "pv": "8bmb:3820:CurrentChannel"},
        {"label": "scan_busy", "pv": "8bmbsft:Fscan1.BUSY"},
        {"label": "is_paused", "pv": "8bmbsft:FscanPause.VAL"},
        {"label": "is_wait_inner", "pv": "8bmbsft:FscanH.WCNT"},
        {"label": "is_wait_outer", "pv": "8bmbsft:Fscan1.WCNT"}
        
      ]
    },

    "struck_miss_trigger": {
      "comment": "MCS 3820 still acquiring and missing triggers (current_channel < nuse_all) but the stage already completed its motion (requested ~ actual position).",
      "inputs": [
        {"label": "scan_busy", "pv": "8bmbsft:Fscan1.BUSY"},
        {"label": "acquiring", "pv": "8bmb:3820:Acquiring"},
        {"label": "nuse_all", "pv": "8bmb:3820:NuseAll"},
        {"label": "dwell_time", "pv": "8bmb:Flyscans:Setup:DwellTime.VAL"},
        {"label": "elapsed_time", "pv": "8bmb:3820:ElapsedReal"},
        {"label": "current_channel", "pv": "8bmb:3820:CurrentChannel"},
        {"label": "requested_position", "pv": "8bmb:m27.VAL"},
        {"label": "actual_position", "pv": "8bmb:m27.RBV"}
      ]
    },

    "xspress3_miss_trigger": {
      "comment": "Xspress3 missed acquisition triggers: array_counter lags number_of_images while the detector is still in an acquiring state.",
      "inputs": [
        {"label": "scan_busy", "pv": "8bmbsft:Fscan1.BUSY"},
        {"label": "array_rate", "pv": "8bmbXP3:det1:ArrayRate_RBV"},
        {"label": "array_num", "pv": "8bmbXP3:det1:NumImages_RBV"},
        {"label": "array_counter", "pv": "8bmbXP3:det1:ArrayCounter_RBV"},
        {"label": "struck_current", "pv": "8bmb:3820:CurrentChannel"},
        {"label": "struck_all", "pv": "8bmb:3820:NuseAll"},
        {"label": "struck_acquiring", "pv": "8bmb:3820:Acquiring"}
      ]
    },

    "xspress3_lost_frame": {
      "comment": "Xspress3 number of saved frames differs from received triggers and the HDF writer remains capturing.",
      "inputs": [
        {"label": "scan_busy", "pv": "8bmbsft:Fscan1.BUSY"},
        {"label": "array_rate", "pv": "8bmbXP3:det1:ArrayRate_RBV"},
        {"label": "num_frames", "pv": "8bmbXP3:HDF1:NumCapture_RBV"},
        {"label": "saved_frames", "pv": "8bmbXP3:HDF1:NumCaptured_RBV"},
        {"label": "struck_current", "pv": "8bmb:3820:CurrentChannel"},
        {"label": "struck_all", "pv": "8bmb:3820:NuseAll"},
        {"label": "struck_acquiring", "pv": "8bmb:3820:Acquiring"}
      ]
    },

    "write_error": {
      "comment": "Xspress3 write error: the detector is in an error state and the HDF writer is not capturing.",
      "inputs": [
        {"label": "scan_busy", "pv": "8bmbsft:Fscan1.BUSY"},
        {"label": "write_status", "pv": "8bmbXP3:HDF1:WriteStatus_RBV"}
      ]
    },

    "filename_not_insync": {
      "comment": "Area detector / xspress3 filename PVs are out of sync with the scan.",
      "inputs": [
        {"label": "scan_busy", "pv": "8bmbsft:Fscan1.BUSY"},
        {"label": "capture", "pv": "8bmbXP3:HDF1:Capture_RBV"},
        {"label": "xp3_file_number", "pv": "8bmbXP3:HDF1:FileNumber"},
        {"label": "xp3_file_name", "pv": "8bmbXP3:HDF1:FileName", "as": "string"},
        {"label": "scan_line", "pv": "8bmbsft:Fscan1.CPT"},
        {"label": "mda_scan_number", "pv": "8bmbsft:saveData_scanNumber"}
      ]
    },

    "stage_stuck": {
      "comment": "Sample stage does not advance to its next scan position: requested != actual position persists while the scan is busy and velocity is ~0.",
      "inputs": [
        {"label": "struck_acquiring", "pv": "8bmb:3820:Acquiring"},
        {"label": "inner_busy", "pv": "8bmbsft:FscanH.BUSY"},
        {"label": "is_moving", "pv": "8bmb:m27.DMOV"},
        {"label": "struck_current", "pv": "8bmb:3820:CurrentChannel"},
        {"label": "elapsed_time", "pv": "8bmb:3820:ElapsedReal"}
      ]
    }
  },

  "flag_events": [
    {"label": "scan_execute", "pv": "8bmbsft:Fscan1.EXSC"},
    {"label": "acquiring", "pv": "8bmb:3820:Acquiring"},
    {"label": "dwell_time", "pv": "8bmb:Flyscans:Setup:DwellTime.VAL"},
    {"label": "elapsed_real", "pv": "8bmb:3820:ElapsedReal"},
    {"label": "nuse_all", "pv": "8bmb:3820:NuseAll"},
    {"label": "current_channel", "pv": "8bmb:3820:CurrentChannel"},
    {"label": "number_of_images", "pv": "8bmbXP3:det1:NumImages_RBV"},
    {"label": "array_counter", "pv": "8bmbXP3:det1:ArrayCounter_RBV"},
    {"label": "detector_state", "pv": "8bmbXP3:det1:DetectorState_RBV"},
    {"label": "trigger_mode", "pv": "8bmbXP3:det1:TriggerMode_RBV"},
    {"label": "capture", "pv": "8bmbXP3:HDF1:Capture_RBV"},
    {"label": "full_file_name", "pv": "8bmbXP3:HDF1:FullFileName_RBV", "as": "string"},
    {"label": "file_path_exists", "pv": "8bmbXP3:HDF1:FilePathExists_RBV"},
    {"label": "array_rate", "pv": "8bmbXP3:det1:ArrayRate_RBV"},
    {"label": "requested_position", "pv": "8bmb:m27.VAL"},
    {"label": "actual_position", "pv": "8bmb:m27.RBV"},
    {"label": "velocity", "pv": "8bmb:m27.VELO"},
    {"label": "vmax", "pv": "8bmb:m27.VMAX"},
    {"label": "beam_current", "pv": "S:SRcurrentAI"},
    {"label": "actual_mode", "pv": "S:ActualMode"}
  ]
}
